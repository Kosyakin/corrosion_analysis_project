CREATE TABLE public.components (
	id serial4 NOT NULL,
	equipment_id int4 NOT NULL,
	"name" varchar(100) NOT NULL,
	source_component varchar(100) NULL,
	material_code_id int4 NULL,
	component_type varchar(50) NULL,
	operating_temperature numeric(6, 1) NULL,
	operating_pressure numeric(8, 3) NULL,
	outer_diameter numeric(8, 1) NULL,
	inner_diameter numeric(8, 1) NULL,
	initial_thickness numeric(6, 1) NULL,
	tank_volume numeric(10, 1) NULL,
	component_type_code int2 GENERATED ALWAYS AS (
CASE
    WHEN lower(COALESCE(component_type, ''::character varying)::text) ~~ '%участок%'::text THEN 1
    WHEN lower(COALESCE(component_type, ''::character varying)::text) ~~ '%отвод%'::text OR lower(COALESCE(name, ''::character varying)::text) ~~ 'отвод%'::text THEN 2
    WHEN lower(COALESCE(component_type, ''::character varying)::text) ~~ '%тройник%'::text THEN 3
    WHEN lower(COALESCE(component_type, ''::character varying)::text) ~~ '%переход%'::text OR lower(COALESCE(component_type, ''::character varying)::text) ~~ '%редукт%'::text THEN 4
    WHEN lower(COALESCE(component_type, ''::character varying)::text) ~~ '%заглуш%'::text THEN 5
    WHEN lower(COALESCE(component_type, ''::character varying)::text) ~~ '%фланец%'::text THEN 6
    WHEN lower(COALESCE(component_type, ''::character varying)::text) ~~ '%задвиж%'::text OR lower(COALESCE(component_type, ''::character varying)::text) ~~ '%клапан%'::text OR lower(COALESCE(component_type, ''::character varying)::text) ~~ '%вентиль%'::text THEN 7
    ELSE 0
END) STORED NULL,
	cross_section_area_mm2 numeric(18, 4) GENERATED ALWAYS AS (
CASE
    WHEN outer_diameter IS NOT NULL THEN pi()::numeric * (outer_diameter * outer_diameter - COALESCE(inner_diameter,
    CASE
        WHEN initial_thickness IS NOT NULL THEN GREATEST(outer_diameter - 2::numeric * initial_thickness, 0::numeric)
        ELSE NULL::numeric
    END) * COALESCE(inner_diameter,
    CASE
        WHEN initial_thickness IS NOT NULL THEN GREATEST(outer_diameter - 2::numeric * initial_thickness, 0::numeric)
        ELSE NULL::numeric
    END)) / 4::numeric
    ELSE NULL::numeric
END) STORED NULL,
	CONSTRAINT new_components_check CHECK (((inner_diameter IS NULL) OR (outer_diameter IS NULL) OR (inner_diameter <= outer_diameter))),
	CONSTRAINT new_components_equipment_id_name_key UNIQUE (equipment_id, name),
	CONSTRAINT new_components_pkey PRIMARY KEY (id),
	CONSTRAINT new_components_equipment_id_fkey FOREIGN KEY (equipment_id) REFERENCES public.equipment(id) ON DELETE CASCADE,
	CONSTRAINT new_components_material_code_id_fkey FOREIGN KEY (material_code_id) REFERENCES public.material_codes(id) ON DELETE SET NULL
);
CREATE INDEX idx_new_components_equipment_name ON public.components USING btree (equipment_id, name);
CREATE INDEX ix_new_components_cross_section_area ON public.components USING btree (cross_section_area_mm2);
CREATE INDEX ix_new_components_type_code ON public.components USING btree (component_type_code);

