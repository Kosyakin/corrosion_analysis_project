Основной список замеров:
— Оконные ф-ии для расчета пар-ов
— Δt и мгновенная V_коррозии.

CREATE MATERIALIZED VIEW public.mv_pipeline_corrosion_base
TABLESPACE pg_default
AS WITH base AS (
         SELECT nm.id AS measurement_id,
            ni.id AS installation_id,
            ni.name AS installation,
            ne.id AS equipment_id,
            ne.name AS equipment,
            nc.id AS component_id,
            nc.name AS component,
            nm.contour,
            nm.mms,
            nm.measurement_date AS curr_measurement_date,
            nm.measurement AS curr_thickness,
            lag(nm.measurement_date) OVER (PARTITION BY ne.id, nc.id, nm.mms ORDER BY nm.measurement_date, nm.id) AS prev_measurement_date,
            lag(nm.measurement) OVER (PARTITION BY ne.id, nc.id, nm.mms ORDER BY nm.measurement_date, nm.id) AS prev_thickness,
            lag(nm.measurement_date, 2) OVER (PARTITION BY ne.id, nc.id, nm.mms ORDER BY nm.measurement_date, nm.id) AS prev2_measurement_date,
            lag(nm.measurement, 2) OVER (PARTITION BY ne.id, nc.id, nm.mms ORDER BY nm.measurement_date, nm.id) AS prev2_thickness,
            nm.nominal_thickness_mmc,
            nm.tmin_mmc,
            nc.initial_thickness,
            nc.component_type,
            nmm.code AS measurement_method_code
           FROM measurements nm
             JOIN components nc ON nc.id = nm.component_id
             JOIN equipment ne ON ne.id = nc.equipment_id
             JOIN installations ni ON ni.id = ne.installation_id
             LEFT JOIN measurement_methods nmm ON nmm.id = nm.measurement_method_id
          WHERE nc.component_type::text = 'Участок трубопровода'::text
        ), derived AS (
         SELECT b.measurement_id,
            b.installation_id,
            b.installation,
            b.equipment_id,
            b.equipment,
            b.component_id,
            b.component,
            b.contour,
            b.mms,
            b.curr_measurement_date,
            b.curr_thickness,
            b.prev_measurement_date,
            b.prev_thickness,
            b.prev2_measurement_date,
            b.prev2_thickness,
            b.nominal_thickness_mmc,
            b.tmin_mmc,
            b.initial_thickness,
            b.component_type,
            b.measurement_method_code,
            EXTRACT(epoch FROM b.curr_measurement_date::timestamp without time zone - b.prev_measurement_date::timestamp without time zone) / 31557600.0 AS delta_years
           FROM base b
        )
 SELECT measurement_id,
    installation_id,
    installation,
    equipment_id,
    equipment,
    component_id,
    component,
    contour,
