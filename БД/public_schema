-- public.mv_environment_features исходный текст

CREATE MATERIALIZED VIEW public.mv_environment_features
TABLESPACE pg_default
AS WITH canon AS (
         SELECT ne.installation_id,
            ne.id AS equipment_id,
            ece.contour,
            lower(TRIM(BOTH FROM ns.name)) AS substance,
            ece.mol_percent
           FROM equipment_chemical_environment ece
             JOIN equipment ne ON ne.id = ece.equipment_id
             LEFT JOIN substances ns ON ns.id = ece.substance_id
        )
 SELECT installation_id,
    equipment_id,
    contour,
    max(
        CASE
            WHEN substance = 'вода'::text THEN mol_percent
            ELSE NULL::numeric
        END) AS water_content,
    max(
        CASE
            WHEN substance = 'сероводород'::text THEN mol_percent
            ELSE NULL::numeric
        END) AS h2s_content,
    max(
        CASE
            WHEN substance = 'хлор'::text THEN mol_percent
            ELSE NULL::numeric
        END) AS chlorine_content,
    max(
        CASE
            WHEN substance = 'диоксид углерода'::text THEN mol_percent
            ELSE NULL::numeric
        END) AS co2_content,
    max(
        CASE
            WHEN substance = 'кислород'::text THEN mol_percent
            ELSE NULL::numeric
        END) AS oxygen_content,
    max(
        CASE
            WHEN substance = 'соляная кислота'::text THEN mol_percent
            ELSE NULL::numeric
        END) AS hydrochloric_acid_content,
    max(
        CASE
            WHEN substance = ANY (ARRAY['аммиак (nh3)'::text, 'аммиак'::text]) THEN mol_percent
            ELSE NULL::numeric
        END) AS ammonia_content,
    max(
        CASE
            WHEN substance = 'ammonium chloride'::text THEN mol_percent
            ELSE NULL::numeric
        END) AS ammonium_chloride_content,
    max(
        CASE
            WHEN substance = 'ингибитор коррозии'::text THEN mol_percent
            ELSE NULL::numeric
        END) AS corrosion_inhibitor_content,
    max(
        CASE
            WHEN substance ~~ 'едкий натр%'::text THEN mol_percent
            ELSE NULL::numeric
        END) AS sodium_hydroxide_content,
        CASE
            WHEN COALESCE(max(
            CASE
                WHEN substance = 'вода'::text THEN mol_percent
                ELSE NULL::numeric
            END), 0::numeric) > 0.001 THEN max(
            CASE
                WHEN substance = 'сероводород'::text THEN mol_percent
                ELSE NULL::numeric
            END) / max(
            CASE
                WHEN substance = 'вода'::text THEN mol_percent
                ELSE NULL::numeric
            END)
            ELSE 0::numeric
        END AS h2s_water_ratio,
    COALESCE(max(
        CASE
            WHEN substance = 'сероводород'::text THEN mol_percent
            ELSE NULL::numeric
        END), 0::numeric) * COALESCE(max(
        CASE
            WHEN substance = 'вода'::text THEN mol_percent
            ELSE NULL::numeric
        END), 0::numeric) * 1000::numeric AS h2s_aggressiveness_index,
    COALESCE(max(
        CASE
            WHEN substance = 'соляная кислота'::text THEN mol_percent
            ELSE NULL::numeric
        END), 0::numeric) * 8::numeric + COALESCE(max(
        CASE
            WHEN substance = 'диоксид углерода'::text THEN mol_percent
            ELSE NULL::numeric
        END), 0::numeric) * 3::numeric + COALESCE(max(
        CASE
            WHEN substance = ANY (ARRAY['уксусная кислота'::text, 'нафтеновая кислота'::text]) THEN mol_percent
            ELSE NULL::numeric
        END), 0::numeric) * 5::numeric AS total_acidity_index,
    COALESCE(max(
        CASE
            WHEN substance = 'хлор'::text THEN mol_percent
            ELSE NULL::numeric
        END), 0::numeric) * 10::numeric + COALESCE(max(
        CASE
            WHEN substance = 'соляная кислота'::text THEN mol_percent
            ELSE NULL::numeric
        END), 0::numeric) * 12::numeric AS chloride_aggressiveness,
    COALESCE(max(
        CASE
            WHEN substance = 'хлор'::text THEN mol_percent
            ELSE NULL::numeric
        END), 0::numeric) * COALESCE(max(
        CASE
            WHEN substance = 'вода'::text THEN mol_percent
            ELSE NULL::numeric
        END), 0::numeric) * 100::numeric AS pitting_corrosion_index,
    COALESCE(max(
        CASE
            WHEN substance = ANY (ARRAY['сероводород'::text, 'сера'::text]) THEN mol_percent
            ELSE NULL::numeric
        END), 0::numeric) * COALESCE(max(
        CASE
            WHEN substance = 'вода'::text THEN mol_percent
            ELSE NULL::numeric
        END), 0::numeric) * 500::numeric + COALESCE(max(
        CASE
            WHEN substance = ANY (ARRAY['ammonium chloride'::text, 'хлор'::text]) THEN mol_percent
            ELSE NULL::numeric
        END), 0::numeric) * 8::numeric AS underdeposit_corrosion_index,
    COALESCE(max(
        CASE
            WHEN substance = 'сероводород'::text THEN mol_percent
            ELSE NULL::numeric
        END), 0::numeric) * 15::numeric + COALESCE(max(
        CASE
            WHEN substance = 'хлор'::text THEN mol_percent
            ELSE NULL::numeric
        END), 0::numeric) * 12::numeric AS stress_corrosion_index,
    COALESCE(max(
        CASE
            WHEN substance = 'ингибитор коррозии'::text THEN mol_percent
            ELSE NULL::numeric
        END), 0::numeric) * 20::numeric + COALESCE(max(
        CASE
            WHEN substance = ANY (ARRAY['аммиак (nh3)'::text, 'аммиак'::text]) THEN mol_percent
            ELSE NULL::numeric
        END), 0::numeric) * 3::numeric + COALESCE(max(
        CASE
            WHEN substance ~~ 'едкий натр%'::text THEN mol_percent
            ELSE NULL::numeric
        END), 0::numeric) * 5::numeric AS corrosion_protection_index,
    count(*) AS total_components,
    sum(mol_percent) AS total_composition,
    COALESCE(max(
        CASE
            WHEN substance = ANY (ARRAY['сероводород'::text, 'сера'::text, 'серная кислота'::text, 'этилмеркаптан'::text]) THEN mol_percent
            ELSE NULL::numeric
        END), 0::numeric) AS total_sulfur_compounds,
    COALESCE(max(
        CASE
            WHEN substance = ANY (ARRAY['соляная кислота'::text, 'хлор'::text]) THEN mol_percent
            ELSE NULL::numeric
        END), 0::numeric) AS total_chlorine_compounds,
    COALESCE(max(
        CASE
            WHEN substance = ANY (ARRAY['уксусная кислота'::text, 'нафтеновая кислота'::text, 'диоксид углерода'::text]) THEN mol_percent
            ELSE NULL::numeric
        END), 0::numeric) AS total_acids,
    COALESCE(max(
        CASE
            WHEN substance = 'сероводород'::text THEN mol_percent * 10::numeric
            ELSE NULL::numeric
        END), 0::numeric) + COALESCE(max(
        CASE
            WHEN substance = 'хлор'::text THEN mol_percent * 5::numeric
            ELSE NULL::numeric
        END), 0::numeric) + COALESCE(max(
        CASE
            WHEN substance = 'соляная кислота'::text THEN mol_percent * 8::numeric
            ELSE NULL::numeric
        END), 0::numeric) AS corrosion_aggressiveness_index
   FROM canon
  GROUP BY installation_id, equipment_id, contour
WITH DATA;

