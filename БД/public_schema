 CREATE TABLE public.material_codes (
	id serial4 NOT NULL,
	material_code varchar(20) NOT NULL,
	material_grade varchar(50) NOT NULL,
	material_type varchar(100) NOT NULL,
	material_resistance_score int2 GENERATED ALWAYS AS (
CASE
    WHEN lower(regexp_replace((COALESCE(material_type, ''::character varying)::text || ' '::text) || COALESCE(material_grade, ''::character varying)::text, '\s+'::text, ' '::text, 'g'::text)) ~~ '%монел%'::text OR lower(regexp_replace((COALESCE(material_type, ''::character varying)::text || ' '::text) || COALESCE(material_grade, ''::character varying)::text, '\s+'::text, ' '::text, 'g'::text)) ~~ '%cu-ni%'::text OR lower(regexp_replace((COALESCE(material_type, ''::character varying)::text || ' '::text) || COALESCE(material_grade, ''::character varying)::text, '\s+'::text, ' '::text, 'g'::text)) ~~ '%cu ni%'::text OR lower(regexp_replace((COALESCE(material_type, ''::character varying)::text || ' '::text) || COALESCE(material_grade, ''::character varying)::text, '\s+'::text, ' '::text, 'g'::text)) ~~ '%nickel%'::text THEN 9
    WHEN (lower(regexp_replace((COALESCE(material_type, ''::character varying)::text || ' '::text) || COALESCE(material_grade, ''::character varying)::text, '\s+'::text, ' '::text, 'g'::text)) ~~ '%аустенит%'::text OR lower(regexp_replace((COALESCE(material_type, ''::character varying)::text || ' '::text) || COALESCE(material_grade, ''::character varying)::text, '\s+'::text, ' '::text, 'g'::text)) ~~ '%austenit%'::text) AND (lower(regexp_replace(COALESCE(material_grade, ''::character varying)::text, '\s+'::text, ' '::text, 'g'::text)) ~ '(^|[^0-9])316(l)?([^0-9]|$)'::text OR lower(regexp_replace(COALESCE(material_grade, ''::character varying)::text, '\s+'::text, ' '::text, 'g'::text)) ~ '(^|[^0-9])317(l)?([^0-9]|$)'::text OR lower(regexp_replace((COALESCE(material_type, ''::character varying)::text || ' '::text) || COALESCE(material_grade, ''::character varying)::text, '\s+'::text, ' '::text, 'g'::text)) ~ '>\s*2\.?25% *mo'::text) THEN 10
    WHEN lower(regexp_replace((COALESCE(material_type, ''::character varying)::text || ' '::text) || COALESCE(material_grade, ''::character varying)::text, '\s+'::text, ' '::text, 'g'::text)) ~~ '%аустенит%'::text OR lower(regexp_replace((COALESCE(material_type, ''::character varying)::text || ' '::text) || COALESCE(material_grade, ''::character varying)::text, '\s+'::text, ' '::text, 'g'::text)) ~~ '%austenit%'::text THEN 8
    WHEN lower(regexp_replace((COALESCE(material_type, ''::character varying)::text || ' '::text) || COALESCE(material_grade, ''::character varying)::text, '\s+'::text, ' '::text, 'g'::text)) ~~ '%феррит%нержав%'::text THEN 7
    WHEN lower(regexp_replace((COALESCE(material_type, ''::character varying)::text || ' '::text) || COALESCE(material_grade, ''::character varying)::text, '\s+'::text, ' '::text, 'g'::text)) ~~ '%cr 9%'::text OR lower(regexp_replace((COALESCE(material_type, ''::character varying)::text || ' '::text) || COALESCE(material_grade, ''::character varying)::text, '\s+'::text, ' '::text, 'g'::text)) ~~ '%cr9%'::text OR lower(regexp_replace((COALESCE(material_type, ''::character varying)::text || ' '::text) || COALESCE(material_grade, ''::character varying)::text, '\s+'::text, ' '::text, 'g'::text)) ~~ '%х9%'::text OR lower(regexp_replace((COALESCE(material_type, ''::character varying)::text || ' '::text) || COALESCE(material_grade, ''::character varying)::text, '\s+'::text, ' '::text, 'g'::text)) ~~ '%cr 5%'::text OR lower(regexp_replace((COALESCE(material_type, ''::character varying)::text || ' '::text) || COALESCE(material_grade, ''::character varying)::text, '\s+'::text, ' '::text, 'g'::text)) ~~ '%cr5%'::text OR lower(regexp_replace((COALESCE(material_type, ''::character varying)::text || ' '::text) || COALESCE(material_grade, ''::character varying)::text, '\s+'::text, ' '::text, 'g'::text)) ~~ '%х5%'::text THEN 6
    WHEN lower(regexp_replace((COALESCE(material_type, ''::character varying)::text || ' '::text) || COALESCE(material_grade, ''::character varying)::text, '\s+'::text, ' '::text, 'g'::text)) ~~ '%2.25 cr 1 mo%'::text OR lower(regexp_replace((COALESCE(material_type, ''::character varying)::text || ' '::text) || COALESCE(material_grade, ''::character varying)::text, '\s+'::text, ' '::text, 'g'::text)) ~~ '%2,25 cr 1 mo%'::text OR lower(regexp_replace((COALESCE(material_type, ''::character varying)::text || ' '::text) || COALESCE(material_grade, ''::character varying)::text, '\s+'::text, ' '::text, 'g'::text)) ~~ '%2.25cr 1mo%'::text THEN 5
    WHEN lower(regexp_replace((COALESCE(material_type, ''::character varying)::text || ' '::text) || COALESCE(material_grade, ''::character varying)::text, '\s+'::text, ' '::text, 'g'::text)) ~~ '%1.25 cr 0.5 mo%'::text OR lower(regexp_replace((COALESCE(material_type, ''::character varying)::text || ' '::text) || COALESCE(material_grade, ''::character varying)::text, '\s+'::text, ' '::text, 'g'::text)) ~~ '%1,25 cr 0.5 mo%'::text OR lower(regexp_replace((COALESCE(material_type, ''::character varying)::text || ' '::text) || COALESCE(material_grade, ''::character varying)::text, '\s+'::text, ' '::text, 'g'::text)) ~~ '%1.25cr 0.5mo%'::text THEN 4
    WHEN lower(regexp_replace(COALESCE(material_type, ''::character varying)::text, '\s+'::text, ' '::text, 'g'::text)) ~~ '%низколегированн%'::text THEN 4
    WHEN lower(regexp_replace((COALESCE(material_type, ''::character varying)::text || ' '::text) || COALESCE(material_grade, ''::character varying)::text, '\s+'::text, ' '::text, 'g'::text)) ~~ '%углеродистая%'::text OR lower(regexp_replace((COALESCE(material_type, ''::character varying)::text || ' '::text) || COALESCE(material_grade, ''::character varying)::text, '\s+'::text, ' '::text, 'g'::text)) ~~ '%углер.%'::text OR lower(regexp_replace(COALESCE(material_grade, ''::character varying)::text, '\s+'::text, ' '::text, 'g'::text)) ~~ '%st3%'::text THEN 2
    ELSE 1
END) STORED NULL,
	CONSTRAINT new_material_codes_material_code_key UNIQUE (material_code),
	CONSTRAINT new_material_codes_pkey PRIMARY KEY (id)
